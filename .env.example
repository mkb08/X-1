# Postgres connection string (Neon). Required: stores headlines, signals, paper trades.
DATABASE_URL=

# Anthropic API key. Required for the AI analysis step (without it the app only shows keyword matches).
ANTHROPIC_API_KEY=
# Only for identity-linked keys that aren't scoped to a workspace (the API asks for it): wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Optional: model and effort for the analysis step.
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium

# Optional: if set, changing settings / opening / closing trades / resetting requires this passcode.
APP_PASSCODE=

# Optional: minimum minutes between scans (protects your API budget). Default 10.
MIN_SCAN_INTERVAL_MIN=10
